  "title": "Meridian Core Funds Transfer (post and confirm)",
  "description": "Sign on to the Meridian Core servicing console as operator teller1, open the specified member record, and post a funds transfer. Populates the transfer form, proceeds through the review screen, and clicks Post Transfer (policy-gated: requires confirmation via the escalation path at replay time). Reads the confirmation number, posted timestamp, posted amount, and resulting balances of both shares. Insufficient funds is detected and returned as a business outcome before the post step is ever reached.",
  "target": {
    "app_id": "meridian_core",
    "base_url": "https://web-sample.interface-hiring.com",
    "tenant_id": "meridian_core",
    "target_version": "4.2.1",
    "surface_kind": "legacy_web"
  },
